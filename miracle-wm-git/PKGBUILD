# Maintainer: Fabio 'Lolix' Loli <fabio.loli@disroot.org> -> https://github.com/FabioLolix

pkgname=miracle-wm-git
pkgver=0.10.1.r1.gd0c7a8e
pkgrel=1
pkgdesc="Wayland tiling window manager built on Mir"
arch=(x86_64)
url="https://github.com/miracle-wm-org/miracle-wm"
license=(GPL-3.0-only)
depends=(
    mir
    libnotify
    wasmedge
    )
makedepends=(
    git
    cmake
    nlohmann-json
    glm
    boost
    #mold # preferred linker
    )
provides=(miracle-wm)
conflicts=(miracle-wm)
source=("git+https://github.com/miracle-wm-org/miracle-wm.git")
sha256sums=('SKIP')

pkgver() {
  cd "miracle-wm"
  git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  # wasmedge-bin installs its headers flat in /usr/include with no wasmedge/
  # subdir, but miracle-wm and wasmedge.h itself #include <wasmedge/...>.
  # Recreate the expected layout with symlinks in a private include dir.
  local _inc="$srcdir/wasmedge-include"
  mkdir -p "$_inc/wasmedge"
  for f in $(pacman -Qql wasmedge-bin | grep '^/usr/include/[^/]*$'); do
    ln -sf "$f" "$_inc/wasmedge/"
  done

  local _flags=(
    -DSYSTEMD_INTEGRATION=ON
    -DWASMEDGE_INCLUDE_DIR="$_inc"
  )

  cmake -B build -S "miracle-wm" -Wno-dev \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    "${_flags[@]}"

  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
